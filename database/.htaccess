# 🔒 Protege scripts sensíveis

# Bloqueia acesso web direto ao seed.php (só localhost via CLI)
<Files "seed.php">
    Order Allow,Deny
    Deny from all
</Files>

# Bloqueia acesso a arquivos de configuração
<FilesMatch "\.(env\.example|config\.php)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>
