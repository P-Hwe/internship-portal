includes:
    - phpstan-bootstrap.neon

parameters:
    level: max
    paths:
        - app
        - public
        - index.php
        - router.php
        - config.php
    excludePaths:
        - vendor
    ignoreErrors:
        - message: '#^Cannot cast mixed to string\.$#'
          identifier: cast.string
          path: app/Database.php
        - message: '#^Cannot cast mixed to int\.$#'
          identifier: cast.int
          path: app/Historico.php
        - message: '#^Method.*has parameter.*with no value type specified in iterable type array\.$#'
          identifier: missingType.iterableValue
          path: app/Database.php
        - message: '#^Method.*return type has no value type specified in iterable type array\.$#'
          identifier: missingType.iterableValue
          path: app/Database.php
        - message: '#^Method.*should return.*but returns mixed\.$#'
          identifier: return.type
          path: app/Database.php
        - message: '#^Parameter.*of function.*expects string, mixed given\.$#'
          identifier: argument.type
          path: app/Database.php
        - message: '#^Method.*has parameter.*with no value type specified in iterable type array\.$#'
          identifier: missingType.iterableValue
          path: app/Historico.php
        - message: '#^Method.*return type has no value type specified in iterable type array\.$#'
          identifier: missingType.iterableValue
          path: app/Historico.php
        - message: '#^Method.*should return string but returns mixed\.$#'
          identifier: return.type
          path: app/Historico.php
        - message: '#^Possibly invalid array key type mixed\.$#'
          identifier: offsetAccess.invalidOffset
          path: app/Historico.php
        - message: '#^Method.*return type has no value type specified in iterable type array\.$#'
          identifier: missingType.iterableValue
          path: app/Paginador.php
        - message: '#^Method.*has parameter.*with no value type specified in iterable type array\.$#'
          identifier: missingType.iterableValue
          path: app/Upload.php
        - message: '#^Argument of an invalid type.*supplied for foreach\.$#'
          identifier: foreach.nonIterable
          path: config.php
        - message: '#^Binary operation.*between.*and mixed results in an error\.$#'
          identifier: binaryOp.invalid
          path: config.php
        - message: '#^Cannot access an offset on mixed\.$#'
          identifier: offsetAccess.nonOffsetAccessible
          path: config.php
        - message: '#^Function.*has parameter.*with no value type specified in iterable type array\.$#'
          identifier: missingType.iterableValue
          path: config.php
        - message: '#^Function.*return type has no value type specified in iterable type array\.$#'
          identifier: missingType.iterableValue
          path: config.php
        - message: '#^Function.*has parameter.*with no type specified\.$#'
          identifier: missingType.parameter
          path: config.php
        - message: '#^Function.*has no return type specified\.$#'
          identifier: missingType.return
          path: config.php
        - message: '#^Instantiated class.*not found\.$#'
          identifier: class.notFound
          path: index.php
        - message: '#^Call to static method.*on an unknown class\.$#'
          identifier: class.notFound
          path: index.php
        - message: '#^Parameter #1 \$url of function parse_url expects string, mixed given\.$#'
          identifier: argument.type
          path: router.php
        - message: '#^Parameter #2 \$subject of function preg_match expects string, string\|false|null given\.$#'
          identifier: argument.type
          path: router.php
