# ============================================
# .gitignore - Padrão para Desenvolvimento (develop e hml)
# ============================================

# ============================================
# Dependências e configurações de IDE
# ============================================
/vendor/
/.idea/
/.vscode/
*.swp
*.swo
*~

# Configurações sensíveis
.env
.env.local
.env.*.local

# ============================================
# Dados sensíveis e uploads
# ============================================
storage/mail/*
storage/termos/*
public/uploads/banners/*
public/uploads/logos/*
public/uploads/capas/*
public/uploads/teste/*

# Banco de dados em memória (apenas dev)
/storage/database.sqlite

# Logs
/logs/
*.log

# ============================================
# Arquivos de desenvolvimento e teste
# PERMITIDOS EM DEVELOP E HML
# ============================================
tests/
test/
_docs/
seed/
scripts/testar-email.php
scripts/check-quality.sh
scripts/fix-style.sh
scripts/seed-local.sh

# Scripts de seed e migração local
database/seed.php
database/.htaccess
database/README-SEED.md

# ============================================
# Arquivos gerados automaticamente
# ============================================
*.pid
*.lock
.cache/

# ============================================
# Arquivos de Docker e setup local
# PERMITIDOS EM DEVELOP E HML
# ============================================
docker-compose.yml
scripts/git-setup.sh
scripts/start-docker.sh
scripts/start-docker.ps1
