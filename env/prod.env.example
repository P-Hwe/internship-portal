# Ambiente: PROD. Copie para .env na raiz do projeto e preencha o que estiver vazio.
# Veja .env.example para a explicação de cada variável.
APP_ENV=prod
APP_URL=https://vagas.seudominio.com.br
PRETTY_URLS=1
DB_HOST=localhost
DB_PORT=3306
DB_NAME=vagas
DB_USER=
DB_PASS=
MAIL_DRIVER=smtp
MAIL_FROM=
MAIL_FROM_NAME=Vagas de Estágio - IFSP Guarulhos
MAIL_REPLY_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USER=
SMTP_PASS=
SMTP_VERIFY_TLS=1
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NOTIFY_EMAIL=
# Nunca rode database/demo.php em produção (o script recusa).
