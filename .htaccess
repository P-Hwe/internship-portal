# Apache/cPanel: bloqueia código, banco, segredos e arquivos privados
Options -Indexes
DirectoryIndex index.php
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(app|Controllers|Models|Views|database|cron|storage|tests|docs)(/|$) - [F,L]
  # URLs limpas (/tv, /admin/login, /vaga/12): tudo que não é arquivo/pasta vai para o index.php, que descobre a página (veja app/Rota.php)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.php [L,QSA]
</IfModule>
<FilesMatch "^(\.env.*|\.git.*|.*\.sql|README\.md|router\.php)$">
  Require all denied
</FilesMatch>
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
